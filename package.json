{
  "name": "equipo-rh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "next lint",
    "lint:css": "stylelint **/*.css",
    "format": "prettier --write **/*.{js,jsx,ts,tsx,css,html,json,md,yml}",
    "prepare": "husky install",
    "create-seed": "bunx snaplet generate --sql > ./supabase/seed.sql && echo 'Seed created at ./supabase/seed.sql'",
    "seed": "bunx supabase db reset"
  },
  "dependencies": {
    "@hookform/resolvers": "3.3.2",
    "@supabase/auth-ui-react": "0.4.6",
    "@supabase/auth-ui-shared": "0.1.8",
    "@supabase/ssr": "0.0.10",
    "@supabase/supabase-js": "2.38.4",
    "@uidotdev/usehooks": "2.4.1",
    "@uppy/compressor": "1.0.5",
    "@uppy/core": "3.6.1",
    "@uppy/dashboard": "3.6.0",
    "@uppy/drag-drop": "3.0.3",
    "@uppy/file-input": "3.0.4",
    "@uppy/locales": "3.3.1",
    "@uppy/progress-bar": "3.0.4",
    "@uppy/react": "3.1.4",
    "@uppy/xhr-upload": "3.4.2",
    "i18next": "23.7.6",
    "material-symbols": "0.14.1",
    "mime": "beta",
    "next": "14.0.3",
    "react": "18.2.0",
    "react-aria": "3.30.0",
    "react-aria-components": "1.0.0-rc.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.47.0",
    "zod": "3.22.4",
    "zod-i18n-map": "2.21.0"
  },
  "devDependencies": {
    "@isnotdefined/stylelint-plugin": "3.1.0",
    "@types/node": "20.9.1",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@typescript-eslint/eslint-plugin": "6.11.0",
    "@typescript-eslint/parser": "6.11.0",
    "eslint": "8.53.0",
    "eslint-config-next": "14.0.3",
    "eslint-config-prettier": "9.0.0",
    "husky": "8.0.3",
    "lint-staged": "15.1.0",
    "prettier": "3.1.0",
    "snaplet": "0.73.0",
    "stylelint": "15.11.0",
    "stylelint-config-clean-order": "5.2.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-plugin-logical-css": "0.13.2",
    "supabase": "1.112.0",
    "typescript": "5.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,css,html,json,md,yml}": "prettier --write",
    "*.css": "stylelint --fix"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
