{
  "name": "equipo-rh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "bun run lint:js && bun run lint:css",
    "lint:js": "next lint",
    "lint:css": "stylelint **/*.css",
    "format": "prettier --write **/*.{js,jsx,ts,tsx,css,html,json,md,yml}",
    "prepare": "husky install"
  },
  "dependencies": {
    "@supabase/auth-ui-react": "0.4.6",
    "@supabase/auth-ui-shared": "0.1.8",
    "@supabase/ssr": "0.0.4",
    "@supabase/supabase-js": "2.38.4",
    "@uppy/compressor": "1.0.5",
    "@uppy/core": "3.6.1",
    "@uppy/dashboard": "3.6.0",
    "@uppy/drag-drop": "3.0.3",
    "@uppy/file-input": "3.0.4",
    "@uppy/image-editor": "2.2.2",
    "@uppy/locales": "3.3.1",
    "@uppy/progress-bar": "3.0.4",
    "@uppy/react": "3.1.4",
    "@uppy/xhr-upload": "3.4.2",
    "next": "14.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@isnotdefined/stylelint-plugin": "3.1.0",
    "@types/node": "20.8.9",
    "@types/react": "18.2.33",
    "@types/react-dom": "18.2.14",
    "@typescript-eslint/eslint-plugin": "6.9.0",
    "@typescript-eslint/parser": "6.9.0",
    "eslint": "8.52.0",
    "eslint-config-next": "14.0.0",
    "eslint-config-prettier": "9.0.0",
    "husky": "8.0.3",
    "lint-staged": "15.0.2",
    "prettier": "3.0.3",
    "stylelint": "15.11.0",
    "stylelint-config-clean-order": "5.2.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-plugin-logical-css": "0.13.2",
    "typescript": "5.2.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix",
    "*.{js,jsx,ts,tsx,css,html,json,md,yml}": "prettier --write",
    "*.css": "stylelint --fix"
  }
}
